<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.IJackDaniel.InfS.controller.WorkspaceController"
            prefWidth="900"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label fx:id="welcomeLabel"
                   text="Добро пожаловать!"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        </HBox>
    </top>

    <center>
        <VBox spacing="10">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <TextArea fx:id="userTextArea"
                      promptText="Введите текст..."
                      wrapText="true"
                      VBox.vgrow="ALWAYS"/>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

            <TextArea fx:id="newPasswordsTextArea"
                      editable="false"
                      visible="false"
                      managed="false"
                      wrapText="true"
                      prefHeight="130"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Button text="Сохранить"
                    onAction="#onSaveButtonClick"/>

            <Button text="Выйти"
                    onAction="#onLogoutButtonClick"/>

        </HBox>
    </bottom>

</BorderPane>