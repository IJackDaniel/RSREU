<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.IJackDaniel.InfS.controller.RegisterController"
            prefWidth="700"
            prefHeight="550">

    <center>

        <VBox alignment="CENTER"
              spacing="15"
              maxWidth="400">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <Label text="Регистрация"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <TextField fx:id="loginField"
                       promptText="Введите логин"
                       prefWidth="350"/>

            <Button text="Параметры генератора паролей"
                    prefWidth="350"
                    onAction="#onGeneratorSettingsButtonClick"/>

            <Button text="Создать пользователя"
                    prefWidth="350"
                    onAction="#onRegisterButtonClick"/>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

            <TextArea fx:id="passwordsTextArea"
                      promptText="Здесь появятся одноразовые пароли"
                      editable="false"
                      wrapText="true"
                      prefHeight="180"
                      prefWidth="350"/>

            <Button text="Вернуться ко входу"
                    prefWidth="350"
                    onAction="#onBackButtonClick"/>

        </VBox>

    </center>

</BorderPane>