<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.IJackDaniel.InfS.controller.GeneratorSettingsController"
            prefWidth="620"
            prefHeight="650">

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="25"
                        right="30"
                        bottom="25"
                        left="30"/>
            </padding>

            <Label text="Параметры генератора паролей"
                   style="-fx-font-size: 23px; -fx-font-weight: bold;"/>

            <Label text="Количественная оценка стойкости парольной защиты"
                   style="-fx-font-size: 15px;"/>

            <Separator/>

            <GridPane hgap="15"
                      vgap="12">

                <Label text="Вероятность подбора P:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="probabilityField"
                           promptText="0.00001"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Скорость перебора V, паролей/мин:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="attemptsPerMinuteField"
                           promptText="3"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Срок действия T, дней:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="validityDaysField"
                           promptText="10"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <Separator/>

            <Label text="Используемые группы символов:"
                   style="-fx-font-weight: bold;"/>

            <CheckBox fx:id="lowercaseCheckBox"
                      text="Строчные латинские буквы (a-z)"/>

            <CheckBox fx:id="uppercaseCheckBox"
                      text="Прописные латинские буквы (A-Z)"/>

            <CheckBox fx:id="digitsCheckBox"
                      text="Цифры (0-9)"/>

            <CheckBox fx:id="specialSymbolsCheckBox"
                      text="Специальные символы (!@#$%^&amp;*)"/>

            <Button text="Рассчитать стойкость"
                    prefWidth="220"
                    onAction="#onCalculateButtonClick"/>

            <Separator/>

            <Label text="Результат расчёта"
                   style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

            <GridPane hgap="15"
                      vgap="10">

                <Label text="Мощность алфавита A:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <Label fx:id="alphabetPowerLabel"
                       text="-"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Нижняя граница S*:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <Label fx:id="requiredPasswordsLabel"
                       text="-"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

                <Label text="Расчётная минимальная длина:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <Label fx:id="calculatedLengthLabel"
                       text="-"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

                <Label text="Используемая длина L:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <Label fx:id="passwordLengthLabel"
                       text="-"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>

                <Label text="Количество комбинаций A^L:"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <Label fx:id="passwordsCountLabel"
                       text="-"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="1"/>

            </GridPane>

            <Label fx:id="messageLabel"
                   wrapText="true"/>

            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <Button text="Применить"
                        prefWidth="130"
                        onAction="#onApplyButtonClick"/>

                <Button text="Отмена"
                        prefWidth="130"
                        onAction="#onCancelButtonClick"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>