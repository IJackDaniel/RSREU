<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.IJackDaniel.InfSecurity.Lab3.controller.MainController"
      alignment="TOP_CENTER"
      spacing="12"
      prefWidth="600"
      prefHeight="500">

    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="modeToggleGroup"/>
    </fx:define>

    <Label text="Шифр перестановки"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="0">
        <ToggleButton fx:id="simpleModeButton"
                      text="Обычный"
                      prefWidth="140"
                      toggleGroup="$modeToggleGroup"/>

        <ToggleButton fx:id="blockModeButton"
                      text="Блочный"
                      prefWidth="140"
                      selected="true"
                      toggleGroup="$modeToggleGroup"/>
    </HBox>

    <VBox spacing="6" fillWidth="true">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Исходный текст"
                   style="-fx-font-weight: bold;"/>

            <Button text="Справка по алфавиту ASCII"
                    onAction="#onHelp"/>
        </HBox>

        <TextArea fx:id="inputTextArea"
                  promptText="Enter your text..."
                  prefRowCount="5"
                  wrapText="true"/>

    </VBox>

    <VBox spacing="6" fillWidth="true">

        <Label text="Ключ перестановки"
               style="-fx-font-weight: bold;"/>

        <TextField fx:id="keyField"
                   promptText="Введите ключ перестановки"/>

    </VBox>

    <HBox alignment="CENTER" spacing="14">

        <Button text="Зашифровать"
                prefWidth="140"
                onAction="#onEncrypt"/>

        <Button text="Расшифровать"
                prefWidth="140"
                onAction="#onDecrypt"/>

        <Button text="Очистить"
                prefWidth="120"
                onAction="#onClear"/>

    </HBox>

    <VBox spacing="6" fillWidth="true">

        <Label text="Результат"
               style="-fx-font-weight: bold;"/>

        <TextArea fx:id="resultTextArea"
                  prefRowCount="5"
                  editable="false"
                  wrapText="true"/>

    </VBox>

</VBox>